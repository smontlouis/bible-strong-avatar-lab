{
  "name": "@bible-strong/avatar-react-native",
  "version": "0.2.0",
  "description": "React Native renderer for Bible Strong procedural avatars, sampled on the UI thread.",
  "keywords": [
    "avatar",
    "svg",
    "animation",
    "react-native",
    "reanimated",
    "expo",
    "typescript"
  ],
  "author": "Stéphane Montlouis-Calixte",
  "license": "MIT",
  "homepage": "https://github.com/smontlouis/bible-strong-avatar-lab/tree/main/packages/avatar-react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smontlouis/bible-strong-avatar-lab.git",
    "directory": "packages/avatar-react-native"
  },
  "bugs": {
    "url": "https://github.com/smontlouis/bible-strong-avatar-lab/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bible-strong/avatar-core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "*",
    "react-native-reanimated": ">=4.7.0",
    "react-native-svg": ">=15.0.0",
    "react-native-worklets": ">=0.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "19.2.3",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  }
}
